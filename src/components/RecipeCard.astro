---
interface Props {
  href: string;
  title: string;
  description: string;
  image: string;
  minutes: number;
  categories: string[];
  featured?: boolean;
}

const { href, title, description, image, minutes, categories, featured = false } = Astro.props;
---

<a class:list={['recipe', { 'recipe--featured': featured }, 'reveal']} href={href}>
  <div class="recipe__media">
    <img src={image} alt={title} loading="lazy" width="800" height="600" />
  </div>
  <div class="recipe__body">
    <p class="recipe__meta">
      <span>{minutes} min</span>
      {categories[0] && <span>{categories[0]}</span>}
    </p>
    <h3 class="recipe__title">{title}</h3>
    <p class="recipe__desc">{description}</p>
  </div>
</a>

<style>
  .recipe {
    display: grid;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
  }

  .recipe:hover .recipe__title {
    color: var(--color-tomato);
  }

  .recipe:hover .recipe__media img {
    transform: scale(1.035);
  }

  .recipe__media {
    overflow: hidden;
    aspect-ratio: 3 / 2;
    background: var(--color-olive);
  }

  .recipe__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .recipe__meta {
    display: flex;
    gap: 0.65rem;
    margin: 0 0 0.25rem;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .recipe__title {
    font-size: 1.35rem;
    margin: 0 0 0.3rem;
    transition: color 0.25s ease;
    line-height: 1.2;
  }

  .recipe__desc {
    margin: 0;
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .recipe--featured {
    gap: 1.35rem;
  }

  .recipe--featured .recipe__title {
    font-size: clamp(1.55rem, 3vw, 2.05rem);
  }

  .recipe--featured .recipe__desc {
    -webkit-line-clamp: 2;
  }

  .recipe--featured .recipe__media {
    aspect-ratio: 16 / 10;
  }

  @media (min-width: 800px) {
    .recipe--featured {
      grid-template-columns: 1.25fr 1fr;
      align-items: center;
    }
  }
</style>
