---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import RecipeCard from '../components/RecipeCard.astro';
import HubLinks from '../components/HubLinks.astro';
import { hubs } from '../lib/hubs';

const recipes = await getCollection('recipes');
const heroImage = '/images/recipes/pasta-pesto-kip-cherrytomaat.jpg';
const slugs = recipes.map((r) => r.id);

const newest = [...recipes].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featured = newest[0];
const rest = newest.slice(1, 7);

const websiteLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Makkelijklekker',
    url: 'https://www.makkelijklekker.nl/',
    description:
      'Recepten die je gewoon kunt koken — lunch, diner, toetjes. Sinds 2015.',
    inLanguage: 'nl-NL',
    publisher: {
      '@type': 'Organization',
      name: 'Makkelijklekker',
      url: 'https://www.makkelijklekker.nl/',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'Makkelijklekker',
    url: 'https://www.makkelijklekker.nl/',
    description: 'Makkelijke recepten die lekker smaken. Sinds 2015.',
    founder: {
      '@type': 'Person',
      name: 'Jelle Hoogeveen',
    },
  },
];
---

<BaseLayout
  title="Makkelijklekker"
  description="Makkelijke recepten die lekker smaken. Pasta, lunch, vega, toetjes — zonder chef-gedoe, met boodschappen uit de super."
  image={heroImage}
  imageAlt="Pasta pesto met kip en cherrytomaat"
  jsonLd={websiteLd}
>
  <Nav />
  <Hero image={heroImage} recipeSlugs={slugs} />

  <main>
    <section class="section container">
      <div class="section__head reveal">
        <h2>Nieuw op het bord</h2>
        <p>
          De laatste recepten die erbij kwamen. Geen fancy verhaal — gewoon dingen die je vanavond
          kunt koken.
        </p>
      </div>

      <div class="home-picks">
        {
          featured && (
            <div class="featured">
              <RecipeCard
                featured
                href={`/recepten/${featured.id}/`}
                title={featured.data.title}
                description={featured.data.description}
                image={featured.data.image}
                minutes={featured.data.minutes}
                categories={featured.data.categories}
              />
            </div>
          )
        }

        <div class="grid">
          {
            rest.map((recipe) => (
              <RecipeCard
                href={`/recepten/${recipe.id}/`}
                title={recipe.data.title}
                description={recipe.data.description}
                image={recipe.data.image}
                minutes={recipe.data.minutes}
                categories={recipe.data.categories}
              />
            ))
          }
        </div>
      </div>

      <section class="hubs reveal">
        <h2>Waar heb je zin in?</h2>
        <p>Begin bij een verzameling — sneller dan scrollen door alles.</p>
        <HubLinks hubs={hubs} />
      </section>

      <div class="more reveal">
        <a class="btn" href="/recepten/">Alle recepten</a>
        <button
          type="button"
          class="btn btn-secondary"
          data-random-recipe
          data-slugs={slugs.join(',')}
        >
          Wat eten we vandaag?
        </button>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-random-recipe]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slugs = (btn.dataset.slugs ?? '').split(',').filter(Boolean);
      if (!slugs.length) return;
      const slug = slugs[Math.floor(Math.random() * slugs.length)];
      window.location.href = `/recepten/${slug}/`;
    });
  });
</script>

<style>
  .section {
    padding: clamp(3.25rem, 8vw, 5.5rem) 0;
  }

  .section__head {
    max-width: 34rem;
    margin-bottom: 2.75rem;
  }

  .section__head h2 {
    font-size: clamp(2rem, 4vw, 2.75rem);
    color: var(--color-olive-deep);
    margin-bottom: 0.55rem;
  }

  .section__head p {
    color: var(--color-ink-soft);
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.55;
  }

  .featured {
    margin-bottom: 3.25rem;
  }

  .grid {
    display: grid;
    gap: 2.35rem 1.5rem;
  }

  .hubs {
    margin: 3.5rem 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-line);
  }

  .hubs h2 {
    margin: 0 0 0.4rem;
    font-size: clamp(1.6rem, 3vw, 2rem);
    color: var(--color-olive-deep);
  }

  .hubs p {
    margin: 0 0 1rem;
    color: var(--color-ink-soft);
  }

  .more {
    margin: 3.25rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
