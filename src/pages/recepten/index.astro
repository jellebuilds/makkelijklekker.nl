---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import RecipeCard from '../../components/RecipeCard.astro';

const recipes = (await getCollection('recipes')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const categories = [...new Set(recipes.flatMap((r) => r.data.categories))].sort((a, b) =>
  a.localeCompare(b, 'nl')
);

const slugs = recipes.map((r) => r.id);
---

<BaseLayout
  title="Alle makkelijke recepten"
  description={`Bekijk ${recipes.length} makkelijke recepten die lekker smaken: pasta, salades, vlees, vis, vegetarisch en toetjes. Zoek, filter op tijd of categorie.`}
>
  <Nav />
  <main class="page">
    <div class="container">
      <header class="page__head reveal">
        <div class="page__intro">
          <h1>Makkelijke recepten</h1>
          <p>
            {recipes.length} snelle recepten. Zoek op naam, filter op tijd of categorie — of laat het
            lot beslissen.
          </p>
        </div>
        <button
          type="button"
          class="btn btn-secondary page__random"
          data-random-recipe
          data-slugs={slugs.join(',')}
        >
          Wat eten we vandaag?
        </button>
      </header>
    </div>

    <div class="toolbar no-print">
      <div class="container toolbar__inner">
        <div class="toolbar__bar">
          <label class="search">
            <span class="visually-hidden">Zoek recepten</span>
            <input
              type="search"
              id="recipe-search"
              placeholder="Zoek op recept, categorie…"
              autocomplete="off"
            />
          </label>

          <button
            type="button"
            class="filters-trigger"
            id="filters-open"
            aria-expanded="false"
            aria-controls="filters-sheet"
          >
            Filters<span class="filters-badge" id="filters-badge" hidden></span>
          </button>
        </div>

        <div class="toolbar__active" id="filters-active" hidden>
          <span id="filters-active-text"></span>
          <button type="button" class="toolbar__clear" data-filters-reset>Wissen</button>
        </div>

        <div class="filters-desktop" aria-label="Filters">
          <div class="filters" role="group" aria-label="Filter op tijd">
            <button type="button" class="chip is-active" data-time="all">Alle tijden</button>
            <button type="button" class="chip" data-time="15">≤ 15 min</button>
            <button type="button" class="chip" data-time="30">≤ 30 min</button>
          </div>

          <div class="filters filters--cats" role="group" aria-label="Filter op categorie">
            <button type="button" class="chip is-active" data-filter="all">Alles</button>
            {
              categories.map((cat) => (
                <button type="button" class="chip" data-filter={cat}>
                  {cat}
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <p class="results" id="results-count" aria-live="polite"></p>

      <div class="grid" id="recipe-grid">
        {
          recipes.map((recipe) => (
            <div
              class="grid__item"
              data-categories={recipe.data.categories.join('|')}
              data-minutes={recipe.data.minutes}
              data-search={`${recipe.data.title} ${recipe.data.description} ${recipe.data.categories.join(' ')}`.toLowerCase()}
            >
              <RecipeCard
                href={`/recepten/${recipe.id}/`}
                title={recipe.data.title}
                description={recipe.data.description}
                image={recipe.data.image}
                minutes={recipe.data.minutes}
                categories={recipe.data.categories}
              />
            </div>
          ))
        }
      </div>

      <p class="empty" id="empty-state" hidden>Geen recepten gevonden. Probeer een andere zoekterm of filter.</p>
    </div>
  </main>

  <div class="filters-sheet no-print" id="filters-sheet" aria-hidden="true" hidden>
    <div class="filters-sheet__backdrop" data-filters-close></div>
    <div
      class="filters-sheet__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="filters-sheet-title"
      tabindex="-1"
    >
      <div class="filters-sheet__chrome">
        <h2 id="filters-sheet-title">Filters</h2>
        <button type="button" class="filters-sheet__close" data-filters-close aria-label="Sluiten">
          ×
        </button>
      </div>

      <div class="filters-sheet__content">
        <div class="filters-section">
          <p class="filters-section__label">Tijd</p>
          <div class="filters" role="group" aria-label="Filter op tijd">
            <button type="button" class="chip is-active" data-time="all">Alle tijden</button>
            <button type="button" class="chip" data-time="15">≤ 15 min</button>
            <button type="button" class="chip" data-time="30">≤ 30 min</button>
          </div>
        </div>

        <div class="filters-section">
          <p class="filters-section__label">Categorie</p>
          <div class="filters filters--cats" role="group" aria-label="Filter op categorie">
            <button type="button" class="chip is-active" data-filter="all">Alles</button>
            {
              categories.map((cat) => (
                <button type="button" class="chip" data-filter={cat}>
                  {cat}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="filters-sheet__footer">
        <button type="button" class="filters-sheet__reset" data-filters-reset>
          Filters wissen
        </button>
        <button type="button" class="btn filters-sheet__apply" id="filters-apply">
          Toon recepten
        </button>
      </div>
    </div>
  </div>

  <Footer />
</BaseLayout>

<script>
  const searchInput = document.getElementById('recipe-search') as HTMLInputElement | null;
  const items = [...document.querySelectorAll<HTMLElement>('.grid__item')];
  const catChips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const timeChips = [...document.querySelectorAll<HTMLButtonElement>('[data-time]')];
  const resultsCount = document.getElementById('results-count');
  const emptyState = document.getElementById('empty-state');
  const sheet = document.getElementById('filters-sheet');
  const sheetPanel = sheet?.querySelector<HTMLElement>('.filters-sheet__panel') ?? null;
  const openBtn = document.getElementById('filters-open') as HTMLButtonElement | null;
  const applyBtn = document.getElementById('filters-apply') as HTMLButtonElement | null;
  const badge = document.getElementById('filters-badge');
  const activeBar = document.getElementById('filters-active');
  const activeText = document.getElementById('filters-active-text');

  let activeCategory = 'all';
  let activeTime = 'all';
  let query = '';
  let visibleCount = items.length;
  let lastFocus: HTMLElement | null = null;

  function activeFilterCount() {
    let n = 0;
    if (activeTime !== 'all') n += 1;
    if (activeCategory !== 'all') n += 1;
    return n;
  }

  function activeFilterSummary() {
    const parts: string[] = [];
    if (activeTime !== 'all') parts.push(`≤ ${activeTime} min`);
    if (activeCategory !== 'all') parts.push(activeCategory);
    return parts.join(' · ');
  }

  function syncChipState() {
    catChips.forEach((c) => c.classList.toggle('is-active', (c.dataset.filter ?? 'all') === activeCategory));
    timeChips.forEach((c) => c.classList.toggle('is-active', (c.dataset.time ?? 'all') === activeTime));
  }

  function updateChrome() {
    const count = activeFilterCount();

    if (badge) {
      if (count > 0) {
        badge.hidden = false;
        badge.textContent = ` · ${count}`;
      } else {
        badge.hidden = true;
        badge.textContent = '';
      }
    }

    if (activeBar && activeText) {
      if (count > 0) {
        activeBar.hidden = false;
        activeText.textContent = activeFilterSummary();
      } else {
        activeBar.hidden = true;
        activeText.textContent = '';
      }
    }

    if (applyBtn) {
      applyBtn.textContent =
        visibleCount === 1 ? 'Toon 1 recept' : `Toon ${visibleCount} recepten`;
    }
  }

  function applyFilters() {
    let visible = 0;
    items.forEach((item) => {
      const cats = item.dataset.categories?.split('|') ?? [];
      const minutes = Number(item.dataset.minutes ?? 999);
      const haystack = item.dataset.search ?? '';
      const matchCat = activeCategory === 'all' || cats.includes(activeCategory);
      const matchTime = activeTime === 'all' || minutes <= Number(activeTime);
      const matchQuery = !query || haystack.includes(query);
      const show = matchCat && matchTime && matchQuery;
      item.hidden = !show;
      if (show) visible += 1;
    });

    visibleCount = visible;

    if (resultsCount) {
      resultsCount.textContent =
        visible === items.length
          ? `${visible} recepten`
          : `${visible} van ${items.length} recepten`;
    }
    if (emptyState) emptyState.hidden = visible > 0;
    updateChrome();
  }

  function clearFilters() {
    activeCategory = 'all';
    activeTime = 'all';
    syncChipState();
    applyFilters();
  }

  function openSheet() {
    if (!sheet || !openBtn) return;
    lastFocus = document.activeElement as HTMLElement | null;
    sheet.hidden = false;
    // next frame so the open transition can run
    requestAnimationFrame(() => {
      sheet.classList.add('is-open');
    });
    sheet.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.classList.add('filters-open');
    sheetPanel?.focus();
  }

  function closeSheet() {
    if (!sheet || !openBtn) return;
    sheet.classList.remove('is-open');
    sheet.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('filters-open');

    const finish = () => {
      sheet.hidden = true;
      sheet.removeEventListener('transitionend', finish);
    };
    sheet.addEventListener('transitionend', finish);
    // fallback if no transition fires
    window.setTimeout(finish, 350);

    (lastFocus ?? openBtn).focus();
  }

  catChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeCategory = chip.dataset.filter ?? 'all';
      syncChipState();
      applyFilters();
    });
  });

  timeChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      activeTime = chip.dataset.time ?? 'all';
      syncChipState();
      applyFilters();
    });
  });

  searchInput?.addEventListener('input', () => {
    query = searchInput.value.trim().toLowerCase();
    applyFilters();
  });

  openBtn?.addEventListener('click', openSheet);
  applyBtn?.addEventListener('click', closeSheet);

  document.querySelectorAll('[data-filters-reset]').forEach((el) => {
    el.addEventListener('click', clearFilters);
  });

  document.querySelectorAll('[data-filters-close]').forEach((el) => {
    el.addEventListener('click', closeSheet);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && sheet?.classList.contains('is-open')) {
      closeSheet();
    }
  });

  document.querySelectorAll<HTMLButtonElement>('[data-random-recipe]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const slugs = (btn.dataset.slugs ?? '').split(',').filter(Boolean);
      if (!slugs.length) return;
      const slug = slugs[Math.floor(Math.random() * slugs.length)];
      window.location.href = `/recepten/${slug}/`;
    });
  });

  applyFilters();
</script>

<style is:global>
  body.filters-open {
    overflow: hidden;
  }
</style>

<style>
  .page {
    padding-bottom: 3rem;
  }

  .page__head {
    padding: clamp(2.25rem, 5vw, 3.5rem) 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .page__intro {
    max-width: 36rem;
  }

  .page__head h1 {
    font-size: clamp(2.3rem, 6vw, 3.5rem);
    color: var(--color-olive-deep);
    margin-bottom: 0.45rem;
  }

  .page__head p {
    color: var(--color-ink-soft);
    margin: 0;
  }

  .toolbar {
    position: sticky;
    top: 3.75rem;
    z-index: 40;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(243, 240, 234, 0.92);
    border-block: 1px solid var(--color-line);
    margin-bottom: 1.75rem;
  }

  .toolbar__inner {
    padding: 0.75rem 0;
    display: grid;
    gap: 0.55rem;
  }

  .toolbar__bar {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.55rem;
    align-items: center;
  }

  .search {
    min-width: 0;
  }

  .search input {
    width: 100%;
    font: inherit;
    padding: 0.7rem 1rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgba(250, 247, 242, 0.9);
    color: var(--color-ink);
  }

  .search input:focus {
    outline: 2px solid var(--color-olive);
    outline-offset: 1px;
  }

  .filters-trigger {
    appearance: none;
    flex-shrink: 0;
    border: 1px solid var(--color-line);
    background: rgba(250, 247, 242, 0.9);
    color: var(--color-olive-deep);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.7rem 1rem;
    border-radius: 999px;
    cursor: pointer;
    white-space: nowrap;
  }

  .filters-trigger:hover,
  .filters-trigger[aria-expanded='true'] {
    background: var(--color-olive);
    border-color: var(--color-olive);
    color: #fff;
  }

  .filters-badge {
    font-weight: 650;
  }

  .toolbar__active {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    font-size: 0.86rem;
    font-weight: 550;
    color: var(--color-ink-soft);
  }

  .toolbar__clear {
    appearance: none;
    border: 0;
    background: none;
    color: var(--color-tomato);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .filters-desktop {
    display: none;
  }

  .filters-section {
    display: grid;
    gap: 0.45rem;
  }

  .filters-section__label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .chip {
    appearance: none;
    border: 1px solid var(--color-line);
    background: rgba(250, 247, 242, 0.75);
    color: var(--color-ink-soft);
    font: inherit;
    font-size: 0.86rem;
    font-weight: 550;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .chip:hover,
  .chip.is-active {
    background: var(--color-olive);
    border-color: var(--color-olive);
    color: #fff;
  }

  /* Mobile bottom sheet — outside toolbar so fixed = viewport */
  .filters-sheet {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
  }

  .filters-sheet.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .filters-sheet__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(28, 32, 24, 0.45);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .filters-sheet.is-open .filters-sheet__backdrop {
    opacity: 1;
  }

  .filters-sheet__panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: min(88vh, 40rem);
    display: flex;
    flex-direction: column;
    background: var(--color-cream, #faf7f2);
    border-radius: 1.15rem 1.15rem 0 0;
    box-shadow: 0 -12px 40px rgba(28, 32, 24, 0.18);
    transform: translateY(105%);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    outline: none;
  }

  .filters-sheet.is-open .filters-sheet__panel {
    transform: translateY(0);
  }

  .filters-sheet__chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.15rem 0.65rem;
    border-bottom: 1px solid var(--color-line);
    flex-shrink: 0;
  }

  .filters-sheet__chrome h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-olive-deep);
  }

  .filters-sheet__close {
    appearance: none;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    background: rgba(250, 247, 242, 0.9);
    color: var(--color-ink-soft);
    font-size: 1.35rem;
    line-height: 1;
    cursor: pointer;
  }

  .filters-sheet__content {
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    padding: 1rem 1.15rem 1.25rem;
    display: grid;
    gap: 1.25rem;
  }

  .filters-sheet__footer {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: center;
    padding: 0.85rem 1.15rem calc(0.85rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--color-line);
    background: rgba(243, 240, 234, 0.98);
    flex-shrink: 0;
  }

  .filters-sheet__reset {
    appearance: none;
    border: 0;
    background: none;
    color: var(--color-ink-soft);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 550;
    cursor: pointer;
    padding: 0.5rem 0.25rem;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .filters-sheet__apply {
    width: 100%;
    padding: 0.75rem 1rem;
  }

  .results {
    margin: 0 0 1.25rem;
    font-size: 0.92rem;
    font-weight: 550;
    color: var(--color-ink-soft);
  }

  .grid {
    display: grid;
    gap: 2.25rem 1.5rem;
  }

  .empty {
    margin: 2rem 0;
    color: var(--color-ink-soft);
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .filters-trigger,
    .toolbar__active,
    .filters-sheet {
      display: none !important;
    }

    .toolbar__bar {
      grid-template-columns: 1fr;
    }

    .toolbar__inner {
      grid-template-columns: minmax(12rem, 1fr) auto;
      align-items: start;
      gap: 0.75rem;
      padding: 0.85rem 0 1rem;
    }

    .toolbar__bar {
      grid-column: 1;
    }

    .filters-desktop {
      display: contents;
    }

    .filters-desktop .filters {
      grid-column: 2;
      align-self: center;
    }

    .filters-desktop .filters--cats {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1000px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
