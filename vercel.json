{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.makkelijklekker.nl" }],
      "destination": "https://makkelijklekker.nl/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/contact.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
